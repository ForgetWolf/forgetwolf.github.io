---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import '../styles/fonts.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/700.css';
import '../styles/vendor/bootstrap.min.css';
import '../styles/vendor/font-awesome.min.css';
import '../styles/main.scss';
interface Props { title?: string; description?: string; article?: boolean; published?: string }
const { title, description = site.description, article = false, published } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a desktop override before the first paint. Mobile remains CSS-auto.
      (() => {
        if (matchMedia('(max-width: 768px), (hover: none) and (pointer: coarse)').matches) return;
        try {
          const mode = localStorage.getItem('typography-color-mode');
          if (mode === 'light' || mode === 'dark') document.documentElement.dataset.theme = mode;
        } catch {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="author" content={site.author} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon.png" />
    <link rel="alternate" type="application/atom+xml" title={site.title} href="/atom.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-container">跳到正文</a>
    <div id="stage" class="container"><div class="row">
      <Sidebar />
      <main id="main-container" class="col-sm-9 col-xs-12 main-container" tabindex="-1">
        <div class="content"><slot /></div>
        <div class="visible-xs site-bottom-footer"><Footer /></div>
      </main>
    </div></div>
    <script src="../scripts/typography.ts"></script>
  </body>
</html>
