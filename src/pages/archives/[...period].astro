---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { allPosts, dateLabel, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  const periods = new Set<string>();
  for (const post of posts) {
    const date = dateLabel(post.data.date);
    periods.add(date.slice(0, 4)); periods.add(date.slice(0, 7).replace('-', '/'));
  }
  return [undefined, ...periods].map(period => ({ params: { period }, props: {
    period, posts: posts.filter(post => !period || dateLabel(post.data.date).replaceAll('-', '/').startsWith(period)),
  } }));
}
interface Props { period?: string; posts: Post[] }
const { posts, period } = Astro.props;
const title = period ? `归档 ${period}` : '归档';
---
<BlogLayout title={title}><h1 class="post-title">{title} 共 {posts.length} 篇文章</h1><PostList posts={posts} /></BlogLayout>
