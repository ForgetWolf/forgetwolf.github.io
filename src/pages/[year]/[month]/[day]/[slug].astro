---
import { render } from 'astro:content';
import BlogLayout from '../../../../layouts/BlogLayout.astro';
import PostMeta from '../../../../components/PostMeta.astro';
import { allPosts, dateLabel, excerpt, postPath, timestamp, type Post } from '../../../../lib/posts';
import { site } from '../../../../site';
import { articleSlug } from '../../../../lib/slug';
import Icon from '../../../../components/Icon.astro';
import { articleData } from '../../../../lib/structured-data';
export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, index) => {
    const [year, month, day] = dateLabel(post.data.date).split('-');
    return { params: { year, month, day, slug: articleSlug(post.data.slug) }, props: { post, newer: posts[index - 1], older: posts[index + 1] } };
  });
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const url = new URL(postPath(post), site.url).href;
const twitter = `https://twitter.com/intent/tweet?${new URLSearchParams({ url, text: post.data.title })}`;
const weibo = `https://service.weibo.com/share/share.php?${new URLSearchParams({ url, title: post.data.title })}`;
---
<BlogLayout title={post.data.title} description={excerpt(post)} article published={new Date(timestamp(post.data.date)).toISOString()} structuredData={articleData(post.data, postPath(post))}>
  <article class="post-container post-page">
    <h1 class="post-title">{post.data.title}</h1>
    <PostMeta post={post} />
    <div class="post-abstract prose"><Content /></div>
  </article>
  <div class="share">分享： <button id="copy-link" type="button" aria-live="polite">复制链接</button>{' '}
    {/* 原 Font Awesome 分享图标转换为 SVG，分享链接与行为保持原样。 */}
    <a href={weibo} target="_blank" rel="noopener noreferrer" aria-label="分享到微博"><Icon name="weibo" /></a>{' '}
    <a href={twitter} target="_blank" rel="noopener noreferrer" aria-label="分享到 Twitter"><Icon name="twitter" /></a>
  </div>
  <nav class="pagination post-pagination" aria-label="相邻文章">
    {newer && <p><a href={postPath(newer)} rel="prev">« 上一篇：{newer.data.title}</a></p>}
    {older && <p><a href={postPath(older)} rel="next">下一篇：{older.data.title} »</a></p>}
  </nav>
</BlogLayout>
