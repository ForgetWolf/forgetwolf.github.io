---
import BlogLayout from '../layouts/BlogLayout.astro';
---
<BlogLayout title="偏航" description="随机阅读一篇文章。" noindex>
  <h1 class="post-title">偏航</h1>
  <p id="random-status" data-random-landing role="status">正在选择一篇文章……</p>
  <p>也可以去<a href="/archives/">归档</a>挑选一篇。</p>
  <noscript><p>随机阅读需要启用 JavaScript；文章仍可从归档正常访问。</p></noscript>
</BlogLayout>
