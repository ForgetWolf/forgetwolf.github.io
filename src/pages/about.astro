---
import { getEntry, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import { profileData } from '../lib/structured-data';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page');
const { Content } = await render(page);
---
<BlogLayout title={page.data.title} description={page.data.desc ?? ''} structuredData={profileData(page.data.title, page.data.desc)}>
  <article class="post-container"><h1 class="post-title">{page.data.title}</h1><div class="post-abstract prose"><Content /></div></article>
</BlogLayout>
